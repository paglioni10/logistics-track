# Banco de dados (sobe local via docker-compose, sem custo)
DATABASE_URL=postgresql+psycopg://logistics:logistics@localhost:5432/logistics_track

# Redis / Celery (fila de polling, local via docker-compose)
REDIS_URL=redis://localhost:6379/0

# Segredo para assinar payloads de webhook (HMAC-SHA256)
WEBHOOK_SIGNING_SECRET=change-me-in-local-env

# --- IA gratuita (opcional) ---
# Fallback de normalização de status via LLM local rodando com Ollama.
# Instale o Ollama (https://ollama.com), rode `ollama pull llama3.2` e
# suba o serviço local (`ollama serve`, padrão em localhost:11434).
# Zero custo: roda 100% na sua máquina, sem chave de API.
LLM_NORMALIZER_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Credenciais de transportadoras (opcional — deixe em branco para rodar
# apenas com o conector de scraping público dos Correios)
JADLOG_API_KEY=
JADLOG_API_BASE_URL=https://www.jadlog.com.br/embarcador/tracking

# Frequência padrão de polling (segundos)
POLLING_INTERVAL_SECONDS=1800

# Alerta de entrega parada sem atualização (horas)
STALLED_SHIPMENT_ALERT_HOURS=48
